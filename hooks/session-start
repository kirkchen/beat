#!/usr/bin/env bash
# SessionStart hook for Beat plugin
# Detects if the current project uses Beat and injects workflow context.

set -euo pipefail

# Check if this project uses Beat (config.yaml or changes/ directory exists)
if [ -f "beat/config.yaml" ] || [ -d "beat/changes" ]; then
  cat <<'EOF'
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "This project uses the Beat BDD workflow plugin.\n\nAfter brainstorming/exploration is complete, transition to Beat instead of writing-plans:\n- Use /beat:design to create a change and generate spec artifacts (proposal, gherkin, design.md)\n- Use /beat:plan to create an execution plan (tasks.md) with multi-role review\n- Beat's plan skill will invoke writing-plans internally when creating tasks\n- Do NOT invoke writing-plans directly — Beat orchestrates the full pipeline\n\nBeat pipeline: /beat:explore → /beat:design → /beat:plan → /beat:apply → /beat:verify → /beat:archive\n- /beat:explore ends by declaring an exit: small / standard (one change), too-big (creates a route under beat/routes/), or blocked (research / prototype / decision node)\n- /beat:verify writes findings to verify.md; /beat:apply fix-from-verify fixes the open CRITICALs (explicit ids for anything else). Zero open CRITICAL is converged; re-runs are incremental and bounded by the iteration ramp\n- /beat:apply never pushes — pushing happens after /beat:archive via finishing-a-development-branch\n- Every skill ends with a Beat Handoff block (references/handoff-report.md)\n\nBeat maintains three project-level living-doc surfaces (all lazy — created on first use):\n- beat/CONTEXT.md — domain glossary maintained inline by design/distill/archive\n- docs/adr/ — ADRs gated by hard-to-reverse + surprising + real trade-off\n- beat/ARCHITECTURE.md + module READMEs — structure & intent, updated when public interfaces change\n\nIf the user asks to build, fix, or change something, guide them through the Beat workflow."
  }
}
EOF
else
  # No Beat setup — output empty JSON (no context injection)
  echo '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""}}'
fi

exit 0
